# Copy to server/.env and fill in. Every value in CAPITALS with YOUR-/CHANGE_ME is a placeholder to replace.
# Real environment variables override this file.

# Web server
PORT=8787
# The public address of the site. Forms posted from any other origin are refused.
ALLOWED_ORIGINS=https://www.YOUR-DOMAIN.com.au,https://YOUR-DOMAIN.com.au
# Set when running behind a reverse proxy or load balancer (loopback, a subnet, or a hop count).
TRUST_PROXY=loopback
# Country from the visitor's IP address (pre-selects Australia or International). Cloudflare, CloudFront, Vercel and
# App Engine send it in a header and need nothing here. Otherwise set a lookup service, e.g. https://ipapi.co/{ip}/country/
# (the visitor's IP is sent to it, so name it in the Privacy Notice).
GEOIP_URL=
# Where enquiries, applications and CVs are stored (keep it backed up, outside the web root).
DATA_DIR=server/data

# Outgoing mail (SMTP). Leave SMTP_HOST empty to run in dry-run mode (emails are logged, not sent).
# Microsoft 365: smtp.office365.com, port 587. Google Workspace: smtp.gmail.com, port 587 with an app password.
# PLACEHOLDER: e.g. smtp.office365.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD_OR_APP_PASSWORD
MAIL_FROM=W&B Instruments <no-reply@YOUR-COMPANY-DOMAIN.com>
# Inbox for website enquiries (defaults to the email in src/data/company.ts).
MAIL_TO=sales@YOUR-COMPANY-DOMAIN.com
# Inbox for careers applications (defaults to MAIL_TO).
MAIL_CAREERS_TO=careers@YOUR-COMPANY-DOMAIN.com
# Send the customer a confirmation email with their reference (true/false).
MAIL_CONFIRM=true

# ---------------------------------------------------------------------------------------------
# Content panel (https://YOUR-DOMAIN/<ADMIN_PATH>/): staff publish news posts, vlogs and job openings.
# One or more accounts as name:password, comma separated. Passwords need 10+ characters.
# The panel stays switched off while this is empty or still holds the placeholder below.
# For a hashed password run:  npm run hash-password -- "the password"   and paste name:scrypt$...
# Web address of the panel. It is not linked from the website and search engines are told not to index it.
# Choose something hard to guess and share it only with staff.
ADMIN_PATH=CHANGE-ME-staff-area
ADMIN_USERS=admin:CHANGE_ME_TO_A_LONG_PASSWORD
# Random text of 32+ characters that signs the sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_64_RANDOM_CHARACTERS
# How long a sign-in lasts, in hours.
SESSION_HOURS=8
# Largest video file that can be uploaded (MB). Longer videos: upload to YouTube or Vimeo and paste the link.
MAX_VIDEO_MB=200
# Company inbox used when MAIL_TO is empty and src/data/company.ts is not present.
COMPANY_EMAIL=sales@YOUR-COMPANY-DOMAIN.com
